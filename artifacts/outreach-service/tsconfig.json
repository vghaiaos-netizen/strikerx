{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"],
    "strictNullChecks": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noImplicitReturns": true,
    "alwaysStrict": true
  },
  "include": ["src"]
}
