# StrikerX Environment Variables
# Copy this file to .env and fill in all values
# NEVER commit .env to git

# ─── DATABASE ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/strikerx

# ─── TELEGRAM BOTS ──────────────────────────────────────────────────────────
GAMEBOT_TOKEN=         # From @BotFather — the player-facing bot
GROUPBOT_TOKEN=        # From @BotFather — the group community bot
MINI_APP_LINK=t.me/StrykkerXBot/StrikerX

# ─── PAYMENTS ───────────────────────────────────────────────────────────────
CRYPTOBOT_TOKEN=       # From @CryptoBot on Telegram
TON_WALLET_ADDRESS=    # TON wallet for player withdrawals
USDT_TRC20_ADDRESS=    # USDT TRC20 address for multi-currency

# ─── SECURITY ───────────────────────────────────────────────────────────────
JWT_SECRET=            # Random 64-char hex string — NEVER change after launch
SESSION_SECRET=        # Random 64-char hex string
ENCRYPTION_KEY=        # AES-256 key — 32 bytes hex

# ─── ADMIN ──────────────────────────────────────────────────────────────────
ADMIN_USERNAME=        # Admin dashboard login username
ADMIN_PASSWORD=        # Admin dashboard login password (bcrypt hashed in prod)

# ─── SERVER ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
WEBHOOK_URL=           # Public HTTPS URL for bot webhooks (production only)

# ─── GITHUB ─────────────────────────────────────────────────────────────────
GITHUB_TOKEN=          # Personal access token for repo sync

# ─── GAME CONFIG (use Replit Configurations for these) ──────────────────────
HOUSE_EDGE_SHOT=4
HOUSE_EDGE_PENALTY=4
HOUSE_EDGE_MINEFIELD=4
HOUSE_EDGE_FREEKICK=4
STRIKER_DEPOSIT_RATE=100
STRIKER_WITHDRAW_RATE=110
MIN_DEPOSIT_TON=0.5
MIN_WITHDRAW_STRIKER=1000
JACKPOT_PERCENTAGE=1
JACKPOT_MIN_POOL=50
JACKPOT_SEED_AMOUNT=10
WAGER_REQUIREMENT_MULTIPLIER=10
REFERRAL_TIER1_PERCENTAGE=10
REFERRAL_TIER2_PERCENTAGE=5
BIG_WIN_ANNOUNCE_THRESHOLD=50
INACTIVE_DAYS_TAG_THRESHOLD=3
NEW_ACCOUNT_REVIEW_THRESHOLD=1
WELCOME_BONUS_STRIKER=500
STREAK_DAY3_BONUS=100
STREAK_DAY7_BONUS=500
STREAK_DAY14_BONUS=1000
STREAK_DAY21_BONUS=2000
STREAK_DAY30_BONUS=5000
